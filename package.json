{
  "name": "explorer-v2",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^6.0.3",
      "@types/node": "^26.6.6",
      "varlock": "1.25.0",
      "@cloudflare/workers-types": "^5.20261112.1",
      "lucide-react": "^1.72.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "@tailwindcss/postcss": "^4.3.5",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.5"
    }
  },
  "type": "module",
  "scripts": {
    "api:generate": "bun run --filter web api:generate",
    "changeset": "changeset",
    "commitlint": "commitlint",
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev:bare",
    "deploy": "vp run --filter @explorer-v2/infra deploy",
    "destroy": "vp run --filter @explorer-v2/infra destroy",
    "env:generate": "varlock codegen --path ./apps/web/",
    "postinstall": "varlock codegen --path ./apps/web/",
    "prepare": "lefthook install",
    "release": "changeset publish",
    "version": "changeset version",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@cloudflare/workers-types": "catalog:",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@explorer-v2/config": "workspace:*",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "catalog:",
    "lefthook": "^2.2.2",
    "rolldown": "1.3.2",
    "typescript": "catalog:",
    "ultracite": "8.0.0",
    "varlock": "catalog:",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "packageManager": "bun@1.4.4"
}
