# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# WalletConnect Cloud project ID. Public identifier, not a secret.
# @public @optional @type=string
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Web Push VAPID public key. Public by design; the browser subscribes with it.
# @public @optional @type=string
VAPID_PUBLIC_KEY=

# VAPID private key. Used by the notifier worker and local push test script.
# @sensitive @optional @type=string
VAPID_PRIVATE_KEY=

# VAPID contact, either a mailto: address or an https URL.
# @sensitive @optional @type=string
VAPID_SUBJECT=

# Discord webhook for BPP-9000 call announcements.
# @sensitive @optional @type=string
DISCORD_WEBHOOK_URL=
