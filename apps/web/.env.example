# WalletConnect is optional. When unset, the explorer hides the WalletConnect option.
# This project ID is a public WalletConnect Cloud identifier, not a secret.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Web Push. Generate a pair with `bun run --cwd packages/infra vapid:generate`.
# Only the public key is served to the browser; keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Discord webhook for BPP-9000 call announcements.
DISCORD_WEBHOOK_URL=
